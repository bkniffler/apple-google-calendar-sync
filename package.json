{
  "name": "insync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "setup": "bun src/index.ts setup",
    "auth:google": "bun src/index.ts auth google",
    "calendars:google": "bun src/index.ts calendars google",
    "calendars:icloud": "bun src/index.ts calendars icloud",
    "conflicts": "bun src/index.ts conflicts",
    "doctor": "bun src/index.ts doctor",
    "migrate": "bun src/index.ts migrate",
    "sync": "bun src/index.ts sync --once",
    "sync:dry": "bun src/index.ts sync --once",
    "sync:apply": "bun src/index.ts sync --once --apply",
    "sync:watch": "bun src/index.ts sync --watch --apply",
    "parity:dry-run": "bun scripts/compare-dry-runs.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "ical.js": "^2.1.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "tsdav": "^2.1.6",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/bun": "^1.3.3",
    "typescript": "^5.9.3"
  }
}
